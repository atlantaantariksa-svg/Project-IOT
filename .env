# Ganti dengan nama unik kelompokmu (huruf kecil, tanpa spasi)
PROJECT_ID=sitsmart_kelompok_01

# Broker publik HiveMQ (tanpa akun, JANGAN kirim data rahasia)
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt

# Ambang batas (default cocok untuk percobaan sungguhan)
LEAN_THRESHOLD_DEG=20
LEAN_HOLD_S=5
SIT_LIMIT_S=1800

# Untuk demo cepat, ubah SIT_LIMIT_S=60 supaya alarm BREAK muncul dalam 1 menit
